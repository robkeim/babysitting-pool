# Fast first line (ADR 0008): format and lint staged files only. CI is authoritative.
cd src/frontend && npx lint-staged --cwd . --relative
cd ../..
cs_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.cs')
if [ -n "$cs_files" ]; then
  # shellcheck disable=SC2086
  dotnet format src/backend/BabysittingPool.sln --include $cs_files
  # shellcheck disable=SC2086
  git add $cs_files
fi
