{
  "permissions": {
    "deny": [
      "Bash(git commit *--no-verify*)",
      "Bash(git commit * -n *)",
      "Bash(git commit -n*)",
      "Bash(git push *--no-verify*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f *)",
      "Bash(git push -f*)",
      "Bash(git push * main*)",
      "Bash(git push * HEAD:main*)",
      "Read(./src/frontend/package-lock.json)",
      "Read(./src/frontend/src/lib/api/schema.gen.ts)",
      "Read(./docs/api/postman_collection.json)",
      "Read(./src/backend/**/Migrations/**)",
      "Read(./docs/research/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-push.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-stop.sh"
          }
        ]
      }
    ]
  }
}
