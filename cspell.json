{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "dictionaries": [],
  "ignoreRegExpList": ["/(?<![\\p{L}\\p{N}\\p{M}'])(?!(?:ageing|behaviour|behaviours|behavioural|cancelled|cancelling|centre|centred|centres|colour|coloured|colourful|colours|defence|favour|favourite|favourites|grey|honour|honoured|honours|initialise|initialised|judgement|labelled|labelling|licence|modelled|modelling|neighbour|neighbourhood|neighbours|normalise|normalised|organise|organised|organisation|recognise|recognised|serialise|serialised)(?![\\p{L}\\p{N}\\p{M}']))[\\p{L}\\p{N}\\p{M}']+/giu"],
  "flagWords": [
    "ageing",
    "behaviour",
    "behaviours",
    "behavioural",
    "cancelled",
    "cancelling",
    "centre",
    "centred",
    "centres",
    "colour",
    "coloured",
    "colourful",
    "colours",
    "defence",
    "favour",
    "favourite",
    "favourites",
    "grey",
    "honour",
    "honoured",
    "honours",
    "initialise",
    "initialised",
    "judgement",
    "labelled",
    "labelling",
    "licence",
    "modelled",
    "modelling",
    "neighbour",
    "neighbourhood",
    "neighbours",
    "normalise",
    "normalised",
    "organise",
    "organised",
    "organisation",
    "recognise",
    "recognised",
    "serialise",
    "serialised"
  ],
  "ignorePaths": [
    "cspell.json",
    "**/node_modules/**",
    "**/bin/**",
    "**/obj/**",
    "**/dist/**",
    "**/*.gen.ts",
    "**/Migrations/**",
    "**/RateLimitMigrations/**",
    "**/package-lock.json",
    "**/fr-FR.json",
    ".semgrep/**",
    "docs/research/**",
    "docs/api/**"
  ]
}
